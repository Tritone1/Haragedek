# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grub_stub?schema=public"

# API and sessions
PORT=4000
API_HOST="127.0.0.1"
WEB_ORIGIN="http://localhost:5173"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Optional Google login. Password login still works without these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
GOOGLE_MAPS_API_KEY=""

# Vite client configuration
VITE_API_URL="/api"
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_MAP_ID=""

# Optional web-push keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@example.com"
VITE_VAPID_PUBLIC_KEY=""
